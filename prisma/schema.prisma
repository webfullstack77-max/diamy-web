// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                  String     @id @default(cuid())
  slug                String     @unique
  name                String
  description         String?
  image               String?
  promoMode           Boolean   @default(false)
  promoImage          String?
  promoDescription    String?
  parentId            String?
  parent              Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children            Category[] @relation("CategoryTree")
  products            Product[]  @relation("ProductCategory")
  subcategoryProducts Product[]  @relation("ProductSubcategory")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  price         Float
  originalPrice Float?
  images        String[]
  materials     String[]
  categoryId    String
  category      Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isCollection    Boolean   @default(false)
  isMassiveGallery Boolean  @default(false)
  variablePrice   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String?
  text      String
  rating    Int      @default(5)
  avatar    String?
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdsQueue {
  id           String    @id @default(cuid())
  title        String
  imageUrl     String
  caption      String
  hashtags     String?
  channels     String    @default("[]")
  scheduleTime DateTime  @default(now())
  status       String    @default("scheduled")
  sentAt       DateTime?
  errorLog     String?
  fbPostId     String?
  igPostId     String?
  createdAt    DateTime  @default(now())

  @@map("ads_queue")
}
