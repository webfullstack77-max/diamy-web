// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                  String     @id @default(cuid())
  slug                String     @unique
  name                String
  description         String?
  image               String?
  promoMode           Boolean   @default(false)
  promoImage          String?
  promoDescription    String?
  parentId            String?
  parent              Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children            Category[] @relation("CategoryTree")
  products            Product[]  @relation("ProductCategory")
  subcategoryProducts Product[]  @relation("ProductSubcategory")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  price         Float
  originalPrice Float?
  images        String[]
  materials     String[]
  categoryId    String
  category      Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isCollection    Boolean   @default(false)
  isMassiveGallery Boolean  @default(false)
  variablePrice   Boolean   @default(false)
  hasDimensions   Boolean   @default(false)
  widthCm         Float?
  heightCm        Float?
  productOfMonthItems ProductOfMonthItem[]
  clientWorks         ClientWork[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Testimonial {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  author      String?
  role        String?
  email       String?
  phone       String?
  text        String?
  rating      Int       @default(5)
  avatar      String?
  orderNote   String?
  isPublished Boolean   @default(false)
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteConfig {
  id String @id @default("main")

  @@map("site_config")
}

model ProductOfMonthItem {
  id        String   @id @default(cuid())
  image     String
  text      String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("product_of_month_items")
}

model AdsQueue {
  id           String    @id @default(cuid())
  title        String
  imageUrl     String
  caption      String
  hashtags     String?
  channels     String    @default("[]")
  productUrl   String?
  scheduleTime DateTime  @default(now())
  status       String    @default("scheduled")
  sentAt       DateTime?
  errorLog     String?
  fbPostId     String?
  igPostId     String?
  videoUrl     String?
  imageUrls    String?
  createdAt    DateTime  @default(now())

  @@map("ads_queue")
}

model AutoPublishConfig {
  id               String    @id @default(cuid())
  enabled          Boolean   @default(false)
  channels         String    @default("[\"whatsapp\"]")
  nextPublishDate  String?
  lastPublishedAt  DateTime?
  lastProductId    String?
  lastProductTitle String?
  updatedAt        DateTime  @updatedAt

  @@map("auto_publish_config")
}

model DailyPromo {
  id         String   @id @default(cuid())
  imageUrl   String
  activeDate DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("daily_promo")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ip        String?
  visitorId String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorId])
  @@map("page_views")
}

model GarmentTemplate {
  id            String   @id @default(cuid())
  name          String
  category      String
  imageUrl      String
  controlPoints Json
  garmentArea   Json?
  maskUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("garment_templates")
}

enum OrderStatus {
  PENDING
  PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Order {
  id            String      @id @default(cuid())
  clientName    String
  clientPhone   String?
  description   String
  totalAmount   Float
  deliveryDate  DateTime
  status        OrderStatus @default(PENDING)
  notes         String?
  alertSentDate String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  payments      Payment[]

  @@map("orders")
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Float
  method     PaymentMethod @default(TRANSFER)
  receiptUrl String?
  note       String?
  createdAt  DateTime      @default(now())

  @@map("payments")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model PopupConfig {
  id               String   @id @default("main")
  isActive         Boolean  @default(true)
  theme            String   @default("halloween")
  title            String   @default("Temporada de Halloween")
  subtitle         String?  @default("Playeras exclusivas Halloween")
  buttonText       String?  @default("Ver Producto")
  slides           String   @default("[]")
  autoPlayInterval Int      @default(4)
  displayFrequency String   @default("always")
  updatedAt        DateTime @updatedAt

  @@map("popup_config")
}

model ClientWork {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  clientName  String?
  badge       String?  @default("Trabajo Real")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_works")
}

model DesignCollection {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  icon        String?       @default("📁")
  coverImage  String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  designs     DesignAsset[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("design_collections")
}

model DesignAsset {
  id           String           @id @default(cuid())
  title        String
  imageUrl     String
  thumbnailUrl String?
  collectionId String
  collection   DesignCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  order        Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("design_assets")
}

